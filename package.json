{
  "name": "cadence-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -k -n \"api,web\" -c \"magenta,cyan\" \"tsx server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
