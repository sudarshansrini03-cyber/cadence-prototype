    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "qrcode.react": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "^10.0.7",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
